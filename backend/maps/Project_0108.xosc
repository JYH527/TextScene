<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenSCENARIO.xsd">
    <FileHeader revMajor="1" revMinor="0" date="2025-12-01T11:30:00" description="Ghost Probe Scenario: Stationary Truck blocks view, Bicyclist crosses" author="Esmini-Expert"/>

    <CatalogLocations>
        <VehicleCatalog>
            <Directory path="../resources/xosc/Catalogs/Vehicles"/>
        </VehicleCatalog>
        <PedestrianCatalog>
            <Directory path="../resources/xosc/Catalogs/Pedestrians"/>
        </PedestrianCatalog>
    </CatalogLocations>

    <RoadNetwork>
        <LogicFile filepath="two-way-four-lane-crossroad.xodr"/>
    </RoadNetwork>

    <!-- 1. 定义实体: 自车、骑自行车者、静止货车 -->
    <Entities>
        <ScenarioObject name="Ego">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_red"/>
        </ScenarioObject>
        <!-- 修改: 静止在路口的卡车 -->
        <ScenarioObject name="Truck_1">
            <CatalogReference catalogName="VehicleCatalog" entryName="semi_truck"/>
        </ScenarioObject>
        <ScenarioObject name="Bicyclist_1">
            <CatalogReference catalogName="VehicleCatalog" entryName="bicycle"/>
        </ScenarioObject>
    </Entities>

    <Storyboard>
        <Init>
            <Actions>
                <!-- 添加: 全局环境设置 (黑夜 + 雨天) -->
                <GlobalAction>
                    <EnvironmentAction>
                        <Environment name="Night_Rain_Environment">
                            <TimeOfDay animation="false" dateTime="2023-11-29T22:00:00"/>
                            <Weather cloudState="overcast">
                                <Sun intensity="0.0" azimuth="0.0" elevation="0.0"/>
                                <Fog visualRange="10000.0"/>
                                <Precipitation precipitationType="rain" intensity="1.0"/>
                            </Weather>
                            <RoadCondition frictionScaleFactor="0.7"/>
                        </Environment>
                    </EnvironmentAction>
                </GlobalAction>

                <!-- ============================
                     1. 自车 (Lane 1, 内侧)
                     ============================ -->
                <Private entityRef="Ego">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <!-- 自车在 Lane 1, s=65 -->
                                <LanePosition roadId="1" laneId="1" offset="0.0" s="65.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="18.33"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                    <!-- 导航: 直行 -->
                    <PrivateAction>
                        <RoutingAction>
                            <AssignRouteAction>
                                <Route name="Ego_Straight" closed="false">
                                    <Waypoint routeStrategy="shortest">
                                        <Position> <LanePosition roadId="1" laneId="1" offset="0.0" s="60.0"/> </Position>
                                    </Waypoint>
                                    <Waypoint routeStrategy="shortest">
                                        <Position> <LanePosition roadId="0" laneId="1" offset="0.0" s="20.0"/> </Position>
                                    </Waypoint>
                                </Route>
                            </AssignRouteAction>
                        </RoutingAction>
                    </PrivateAction>
                </Private>

                <!-- ============================
                     2. 卡车 (静止在路口, Lane 2, 遮挡源)
                     ============================ -->
                <Private entityRef="Truck_1">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <!-- 修改: 卡车静止在路口附近, s=15 (在路口前15米) -->
                                <LanePosition roadId="1" laneId="2" offset="0.0" s="5.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <!-- 修改: 卡车初始速度为0 -->
                                    <AbsoluteTargetSpeed value="0.0"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                    <!-- 修改: 移除卡车的导航路线，因为它不移动 -->
                </Private>

                <!-- ============================
                     3. 骑自行车者 (位置不变, offset -10.5)
                     ============================ -->
                <Private entityRef="Bicyclist_1">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <!-- 骑自行车者在自行车道或人行道，offset -10.5 -->
                                <LanePosition roadId="69" laneId="1" offset="-10.5" s="3.56"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="0.0"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>

        <Story name="GhostProbeStory">
            
            <!-- 剧情 A: 骑自行车者开始过马路 -->
            <Act name="BicyclistStartAct">
                <ManeuverGroup maximumExecutionCount="1" name="BicyclistMoveGroup">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="Bicyclist_1"/>
                    </Actors>
                    <Maneuver name="BicyclistRideManeuver">
                        <Event name="BicyclistRideEvent" priority="overwrite">
                            <!-- 修改触发条件: 当自车接近路口时触发，而不是卡车 -->
                            <!-- 因为卡车现在是静止的，用自车位置触发更合理 -->
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="EgoApproachesIntersection" delay="0" conditionEdge="rising">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="Ego"/>
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <ReachPositionCondition tolerance="2.0">
                                                    <Position>
                                                        <!-- 当自车到达 s=35 时 (离路口35米) -->
                                                        <LanePosition roadId="1" laneId="1" s="35.0"/>
                                                    </Position>
                                                </ReachPositionCondition>
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                            
                            <!-- 动作: 骑自行车 -->
                            <Action name="SetBicycleSpeed">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <!-- 自行车加速，使用linear动态 -->
                                            <SpeedActionDynamics dynamicsShape="linear" value="2.0" dynamicsDimension="rate"/>
                                            <SpeedActionTarget>
                                                <!-- 自行车速度约为10-15 km/h，转换为m/s约为3.0 m/s -->
                                                <AbsoluteTargetSpeed value="3.0"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <Action name="FollowPath">
                                <PrivateAction>
                                    <RoutingAction>
                                        <FollowTrajectoryAction>
                                            <Trajectory name="CrossingPath" closed="false">
                                                <Shape>
                                                    <Polyline>
                                                        <Vertex><Position><LanePosition roadId="69" laneId="1" offset="-10.5" s="3.56"/></Position></Vertex>
                                                        <Vertex><Position><LanePosition roadId="69" laneId="1" offset="0.0" s="3.56"/></Position></Vertex>
                                                        <Vertex><Position><LanePosition roadId="69" laneId="1" offset="12.0" s="3.56"/></Position></Vertex>
                                                    </Polyline>
                                                </Shape>
                                                <TimeReference><None/></TimeReference>
                                                <TrajectoryFollowingMode followingMode="position"/>
                                            </Trajectory>
                                        </FollowTrajectoryAction>
                                    </RoutingAction>
                                </PrivateAction>
                            </Action>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
            </Act>

            <!-- 修改: 移除卡车的刹车剧情，因为它一开始就是静止的 -->
            
        </Story>
    </Storyboard>
</OpenSCENARIO>
<?xml version="1.0" encoding="utf-8"?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenScenario.xsd">
    <FileHeader description="Cut_In_At_Ramp_Entrance" author="System" revMajor="1" revMinor="0" date="2026-05-18T15:00:00"/>
    <ParameterDeclarations/>
    <CatalogLocations>
        <VehicleCatalog>
            <Directory path="../resources/xosc/Catalogs/Vehicles"/>
        </VehicleCatalog>
        <PedestrianCatalog>
            <Directory path="../resources/xosc/Catalogs/Pedestrians"/>
        </PedestrianCatalog>
    </CatalogLocations>
    <RoadNetwork>
        <LogicFile filepath="one-way-three-lane-ramp_out.xodr"/>
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="Ego">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_white"/>
        </ScenarioObject>
        <ScenarioObject name="Adversary">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_red"/>
        </ScenarioObject>
        <ScenarioObject name="BackgroundVehicle">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_blue"/>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <GlobalAction>
                    <EnvironmentAction>
                        <Environment name="Environment1">
                            <TimeOfDay animation="false" dateTime="2026-05-18T12:00:00"/>
                            <Weather cloudState="free">
                                <Sun intensity="80000.0" azimuth="0.0" elevation="1.5"/>
                                <Fog visualRange="100000.0"/>
                                <Precipitation precipitationType="none" intensity="0.0"/>
                            </Weather>
                            <RoadCondition frictionScaleFactor="1.0"/>
                        </Environment>
                    </EnvironmentAction>
                </GlobalAction>
                
                <Private entityRef="Ego">
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="18.0"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-4" s="40.0" offset="0.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <RoutingAction>
                            <AssignRouteAction>
                                <Route name="InitRoute_Ego" closed="false">
                                    <Waypoint routeStrategy="shortest">
                                        <Position><LanePosition roadId="1" laneId="-4" s="40.0" offset="0.0"/></Position>
                                    </Waypoint>
                                    <Waypoint routeStrategy="shortest">
                                        <Position><LanePosition roadId="4" laneId="-2" s="15.0" offset="0.0"/></Position>
                                    </Waypoint>
                                    <Waypoint routeStrategy="shortest">
                                        <Position><LanePosition roadId="0" laneId="-2" s="40.0" offset="0.0"/></Position>
                                    </Waypoint>
                                </Route>
                            </AssignRouteAction>
                        </RoutingAction>
                    </PrivateAction>
                </Private>

                <Private entityRef="BackgroundVehicle">
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="18.0"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-4" s="25.0" offset="0.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <RoutingAction>
                            <AssignRouteAction>
                                <Route name="InitRoute_Background" closed="false">
                                    <Waypoint routeStrategy="shortest">
                                        <Position><LanePosition roadId="1" laneId="-4" s="20.0" offset="0.0"/></Position>
                                    </Waypoint>
                                    <Waypoint routeStrategy="shortest">
                                        <Position><LanePosition roadId="4" laneId="-2" s="15.0" offset="0.0"/></Position>
                                    </Waypoint>
                                    <Waypoint routeStrategy="shortest">
                                        <Position><LanePosition roadId="0" laneId="-2" s="40.0" offset="0.0"/></Position>
                                    </Waypoint>
                                </Route>
                            </AssignRouteAction>
                        </RoutingAction>
                    </PrivateAction>
                </Private>

                <Private entityRef="Adversary">
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="16.0"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-3" s="52.0" offset="0.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <RoutingAction>
                            <AssignRouteAction>
                                <Route name="InitRoute_Adversary" closed="false">
                                    <Waypoint routeStrategy="shortest">
                                        <Position><LanePosition roadId="1" laneId="-3" s="40.0" offset="0.0"/></Position>
                                    </Waypoint>
                                    <Waypoint routeStrategy="shortest">
                                        <Position><LanePosition roadId="6" laneId="-3" s="15.0" offset="0.0"/></Position>
                                    </Waypoint>
                                    <Waypoint routeStrategy="shortest">
                                        <Position><LanePosition roadId="2" laneId="-3" s="40.0" offset="0.0"/></Position>
                                    </Waypoint>
                                </Route>
                            </AssignRouteAction>
                        </RoutingAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>

        <Story name="MainStory">
            <Act name="Act_Adversary_LaneChange">
                <ManeuverGroup maximumExecutionCount="1" name="MG_Adversary_LaneChange">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="Adversary"/>
                    </Actors>
                    <Maneuver name="Man_Adversary_LaneChange">
                        <Event name="Ev_Adversary_LaneChange" priority="overwrite" maximumExecutionCount="1">
                            <Action name="Act_LC_Adversary">
                                <PrivateAction>
                                    <LateralAction>
                                        <LaneChangeAction>
                                            <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="20.0" dynamicsDimension="distance"/>
                                            <LaneChangeTarget>
                                                <RelativeTargetLane entityRef="Adversary" value="-1"/>
                                            </LaneChangeTarget>
                                        </LaneChangeAction>
                                    </LateralAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="Cond_Ego_Reach_Ramp" delay="0" conditionEdge="rising">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="Ego"/>
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <ReachPositionCondition tolerance="2.0">
                                                    <Position>
                                                        <LanePosition roadId="1" laneId="-4" s="75.0" offset="0.0"/>
                                                    </Position>
                                                </ReachPositionCondition>
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="ActStart_Adversary_LaneChange" delay="0" conditionEdge="rising">
                            <ByValueCondition>
                                <SimulationTimeCondition value="0" rule="greaterThan"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
            </Act>
        </Story>
        
        <StopTrigger>
            <ConditionGroup>
                <Condition name="StopCondition" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                        <SimulationTimeCondition value="20.0" rule="greaterThan"/>
                    </ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>
<?xml version="1.0" standalone="yes"?>
<OpenDRIVE>
    <header revMajor="1" revMinor="4" name="TestRoad_VariableCurvature_R50_Optimized" version="1.00" date="2023-11-27">
        <geoReference><![CDATA[+proj=tmerc +lat_0=0 +lon_0=0 +k=1 +x_0=0 +y_0=0 +datum=WGS84 +units=m +vunits=m +no_defs]]></geoReference>
    </header>

    <road name="Test Road Figure 4 (R=50m) - 4 Lanes Double Yellow" length="250.0" id="1" junction="-1">
        <link>
            <!-- 此处无前后继道路 -->
        </link>

        <planView>
            <!-- 第一部分: 直道 -->
            <geometry s="0.0" x="0.0" y="0.0" hdg="0.0" length="100.0">
                <line/>
            </geometry>

            <!-- 第二部分: 缓和曲线 (Spiral) -->
            <geometry s="100.0" x="100.0" y="0.0" hdg="0.0" length="50.0">
                <spiral curvStart="0.0" curvEnd="0.02"/>
            </geometry>

            <!-- 第三部分: 定曲率圆弧 (Arc) -->
            <geometry s="150.0" x="148.75" y="8.19" hdg="0.5" length="100.0">
                <arc curvature="0.02"/>
            </geometry>
        </planView>

        <elevationProfile>
            <elevation s="0.0" a="0.0" b="0.0" c="0.0" d="0.0"/>
        </elevationProfile>

        <lateralProfile>
        </lateralProfile>

        <lanes>
            <laneSection s="0.0">
                <!-- 左侧车道 (对向交通) -->
                <left>
                    <!-- Lane 2: 外侧慢车道 -->
                    <lane id="2" type="driving" level="false">
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                        <!-- 路边线: 白色实线 -->
                        <roadMark sOffset="0.0" type="solid" weight="standard" color="white" width="0.15"/>
                    </lane>
                    <!-- Lane 1: 内侧快车道 -->
                    <lane id="1" type="driving" level="false">
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                        <!-- 车道分界线: 白色虚线 -->
                        <roadMark sOffset="0.0" type="broken" weight="standard" color="white" width="0.15"/>
                    </lane>
                </left>

                <!-- 中心线 (修改处) -->
                <center>
                    <lane id="0" type="none" level="false">
                        <!--
                             修改说明:
                             type="solid solid" -> 表示双实线
                             color="yellow"     -> 黄色
                        -->
                        <roadMark sOffset="0.0" type="solid solid" weight="standard" color="yellow" width="0.15"/>
                    </lane>
                </center>

                <!-- 右侧车道 (正向交通) -->
                <right>
                    <!-- Lane -1: 内侧快车道 -->
                    <lane id="-1" type="driving" level="false">
                        <link>
                        </link>
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                        <!-- 车道分界线: 白色虚线 -->
                        <roadMark sOffset="0.0" type="broken" weight="standard" color="white" width="0.15"/>
                    </lane>
                    <!-- Lane -2: 外侧慢车道 -->
                    <lane id="-2" type="driving" level="false">
                        <link>
                        </link>
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                        <!-- 路边线: 白色实线 -->
                        <roadMark sOffset="0.0" type="solid" weight="standard" color="white" width="0.15"/>
                    </lane>
                </right>
            </laneSection>
        </lanes>
    </road>
</OpenDRIVE>
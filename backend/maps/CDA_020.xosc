<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenSCENARIO.xsd">
    <FileHeader revMajor="1" revMinor="0" date="2023-12-03T20:00:00" description="Ego avoids bicycle in curve then resumes speed (Road 1->0)" author="OpenSCENARIO-Expert"/>

    <ParameterDeclarations/>

    <!-- 资源目录配置 (严格遵守要求) -->
    <!-- 必须的 Catalog 路径（esmini 标准相对路径） -->
    <CatalogLocations>
        <VehicleCatalog>
            <Directory path="../resources/xosc/Catalogs/Vehicles"/>
        </VehicleCatalog>
        <PedestrianCatalog>
            <Directory path="../resources/xosc/Catalogs/Pedestrians"/>
        </PedestrianCatalog>
    </CatalogLocations>

    <RoadNetwork>
        <LogicFile filepath="one-way-two-lane-curved-urban.xodr"/>
    </RoadNetwork>

    <Entities>
        <ScenarioObject name="Ego">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_red"/>
        </ScenarioObject>

        <!-- Target: 自行车 -->
        <ScenarioObject name="TargetBicycle">
            <CatalogReference catalogName="VehicleCatalog" entryName="bicycle"/>
        </ScenarioObject>
    </Entities>

    <Storyboard>
        <Init>
            <Actions>
                <GlobalAction>
                    <EnvironmentAction>
                        <Environment name="Daytime">
                            <TimeOfDay animation="false" dateTime="2023-12-03T12:00:00"/>
                            <Weather cloudState="free">
                                <Sun intensity="100000.0" azimuth="0.0" elevation="1.57"/>
                            </Weather>
                        </Environment>
                    </EnvironmentAction>
                </GlobalAction>

                <!-- Ego 初始化: Road 1 (直道) 末端 -->
                <Private entityRef="Ego">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-4" offset="0.0" s="60.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="20.0"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>

                <!-- TargetBicycle 初始化: Road 0 (弯道) 中部 -->
                <Private entityRef="TargetBicycle">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <!-- Road 0 位于 s=30m 处，完全阻断内侧车道 -->
                                <LanePosition roadId="0" laneId="-4" offset="0.0" s="30.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="0.0"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>

        <Story name="AvoidAndResumeStory">
            <Act name="ComplexManeuverAct">
                <ManeuverGroup maximumExecutionCount="1" name="EgoManeuverGroup">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="Ego"/>
                    </Actors>

                    <!-- 阶段1: 紧急避让 (减速 + 变道) -->
                    <Maneuver name="AvoidanceManeuver">
                        <Event name="BrakeAndSwerveEvent" priority="overwrite">
                            <!-- 动作A: 减速 -->
                            <Action name="DecelerateAction">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" value="-5.0" dynamicsDimension="rate"/>
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="12.0"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <!-- 动作B: 向右变道 -->
                            <Action name="SwerveRightAction">
                                <PrivateAction>
                                    <LateralAction>
                                        <LaneChangeAction>
                                            <LaneChangeTarget>
                                                <AbsoluteTargetLane value="-5"/>
                                            </LaneChangeTarget>
                                            <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="2.5" dynamicsDimension="time"/>
                                        </LaneChangeAction>
                                    </LateralAction>
                                </PrivateAction>
                            </Action>

                            <!-- 触发: 距离自行车 < 45m -->
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="DetectionCondition" delay="0.0" conditionEdge="rising">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="Ego"/>
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <RelativeDistanceCondition entityRef="TargetBicycle" relativeDistanceType="longitudinal" value="15.0" rule="lessThan" freeSpace="true"/>
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>

                    <!-- 阶段2: 恢复速度 (加速) -->
                    <Maneuver name="ResumeSpeedManeuver">
                        <Event name="AccelerateEvent" priority="overwrite">
                            <Action name="AccelerateAction">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <!-- 平滑加速回原车速 -->
                                            <SpeedActionDynamics dynamicsShape="linear" value="3.0" dynamicsDimension="rate"/>
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="20.0"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>

                            <!-- 触发: 到达 Road 0 的 s=55m 处 (此时已越过 s=30m 的自行车并完成变道) -->
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="PassedObstacleCondition" delay="0.0" conditionEdge="rising">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="Ego"/>
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <ReachPositionCondition tolerance="5.0">
                                                    <Position>
                                                        <LanePosition roadId="0" laneId="-5" s="55.0"/>
                                                    </Position>
                                                </ReachPositionCondition>
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>

                </ManeuverGroup>

                <!-- 结束条件: 驶出弯道进入 Road 2 -->
                <StopTrigger>
                    <ConditionGroup>
                        <Condition name="EndSimulation" delay="0.0" conditionEdge="rising">
                            <ByEntityCondition>
                                <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="Ego"/>
                                </TriggeringEntities>
                                <EntityCondition>
                                    <ReachPositionCondition tolerance="5.0">
                                        <Position>
                                            <!-- Road 2 是弯道后的直道，验证是否成功通过 -->
                                            <LanePosition roadId="2" laneId="-5" s="10.0"/>
                                        </Position>
                                    </ReachPositionCondition>
                                </EntityCondition>
                            </ByEntityCondition>
                        </Condition>
                    </ConditionGroup>
                </StopTrigger>
            </Act>
        </Story>
    </Storyboard>
</OpenSCENARIO>
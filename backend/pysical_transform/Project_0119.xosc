<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
    <FileHeader revMajor="1" revMinor="0" date="2025-12-02T14:00:00" description="Merge Collision with Left Blocker" author="ESMINI-Expert"/>
    
    <CatalogLocations>
        <VehicleCatalog>
            <Directory path="../resources/xosc/Catalogs/Vehicles"/>
        </VehicleCatalog>
    </CatalogLocations>

    <RoadNetwork>
        <LogicFile filepath="one-way-three-lane-ramp_in.xodr"/>
    </RoadNetwork>

    <Entities>
        <ScenarioObject name="hero">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_red"/>
        </ScenarioObject>
        <ScenarioObject name="adversary">
            <CatalogReference catalogName="VehicleCatalog" entryName="semi_truck"/>
        </ScenarioObject>
        <ScenarioObject name="blocker">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_blue"/>
        </ScenarioObject>
    </Entities>

    <Storyboard>
        <Init>
            <Actions>
                <GlobalAction>
                    <EnvironmentAction>
                        <Environment name="Night_Rain_Environment">
                            <TimeOfDay animation="false" dateTime="2023-11-29T22:00:00"/>
                            <Weather cloudState="overcast" precipitationType="rain" intensity="1.0"/>
                            <RoadCondition frictionScaleFactor="1.0"/>
                        </Environment>
                    </EnvironmentAction>
                </GlobalAction>
                <!-- 自车: Road 1, Lane -4 (最右) -->
                <Private entityRef="hero">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-4" offset="0.0" s="5.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="13.88"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>

                <!-- 阻挡车: Road 1, Lane -3 (自车左侧), 保持平齐 -->
                <Private entityRef="blocker">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-3" offset="0.0" s="5.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="13.88"/> <!-- 与自车同速 -->
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>

                <!-- 敌车: Road 0 -->
                <Private entityRef="adversary">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="0" laneId="2" offset="0.0" s="15.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="11.11"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>

        <Story name="Merge_Blocker_Story">
            <Act name="All_Move_Act">
                <ManeuverGroup maximumExecutionCount="1" name="Vehicles_Maneuver_Group">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="hero"/>
                        <EntityRef entityRef="adversary"/>
                        <EntityRef entityRef="blocker"/>
                    </Actors>
                    
                    <Maneuver name="Route_Maneuver">
                        <!-- 所有车辆都去往 Road 2 -->
                        <Event name="Assign_Routes" priority="overwrite">
                            <Action name="Hero_Route">
                                <PrivateAction>
                                    <RoutingAction>
                                        <AcquirePositionAction>
                                            <Position><LanePosition roadId="2" laneId="-4" offset="0.0" s="40.0"/></Position>
                                        </AcquirePositionAction>
                                    </RoutingAction>
                                </PrivateAction>
                            </Action>
                            <Action name="Blocker_Route">
                                <PrivateAction>
                                    <RoutingAction>
                                        <AcquirePositionAction>
                                            <Position><LanePosition roadId="2" laneId="-3" offset="0.0" s="40.0"/></Position>
                                        </AcquirePositionAction>
                                    </RoutingAction>
                                </PrivateAction>
                            </Action>
                            <Action name="Adversary_Route">
                                <PrivateAction>
                                    <RoutingAction>
                                        <AcquirePositionAction>
                                            <Position><LanePosition roadId="2" laneId="-4" offset="0.0" s="40.0"/></Position>
                                        </AcquirePositionAction>
                                    </RoutingAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="Start_Condition" delay="0" conditionEdge="rising">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="0" rule="greaterThan"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="Act_Start" delay="0" conditionEdge="rising">
                            <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="Time_Limit" delay="0" conditionEdge="rising">
                    <ByValueCondition><SimulationTimeCondition value="10.0" rule="greaterThan"/></ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>
<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenSCENARIO.xsd">
    <FileHeader revMajor="1" revMinor="0" date="2025-12-01T14:00:00" description="Final Hard Mode: Bicycle crossing from Offset 10 to -10" author="Esmini-Expert"/>

    <CatalogLocations>
        <VehicleCatalog>
            <Directory path="../resources/xosc/Catalogs/Vehicles"/>
        </VehicleCatalog>
        <PedestrianCatalog>
            <Directory path="../resources/xosc/Catalogs/Pedestrians"/>
        </PedestrianCatalog>
    </CatalogLocations>

    <RoadNetwork>
        <LogicFile filepath="two-way-four-lane-crossroad.xodr"/>
    </RoadNetwork>

    <Entities>
        <ScenarioObject name="Ego">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_red"/>
        </ScenarioObject>
        <ScenarioObject name="OcclusionTruck">
            <CatalogReference catalogName="VehicleCatalog" entryName="semi_truck"/>
        </ScenarioObject>
        <ScenarioObject name="GhostBicyclist">
            <CatalogReference catalogName="VehicleCatalog" entryName="bicycle"/>
        </ScenarioObject>
    </Entities>

    <Storyboard>
        <Init>
            <Actions>
                <GlobalAction>
                    <EnvironmentAction>
                        <Environment name="Night_Rain_Environment">
                            <TimeOfDay animation="false" dateTime="2023-11-29T22:00:00"/>
                            <Weather cloudState="overcast">
                                <Sun intensity="0.0" azimuth="0.0" elevation="0.0"/>
                                <Fog visualRange="1000.0"/>
                                <Precipitation precipitationType="rain" intensity="1.0"/>
                            </Weather>
                            <RoadCondition frictionScaleFactor="0.8"/>
                        </Environment>
                    </EnvironmentAction>
                </GlobalAction>
                <!-- 1. 自车 (Road 1, 南 -> 北) -->
                <Private entityRef="Ego">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="1" offset="0.0" s="50.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="16.11"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                    <PrivateAction>
                        <RoutingAction>
                            <AssignRouteAction>
                                <Route name="Ego_Straight" closed="false">
                                    <Waypoint routeStrategy="shortest">
                                        <Position> <LanePosition roadId="1" laneId="1" offset="0.0" s="50.0"/> </Position>
                                    </Waypoint>
                                    <Waypoint routeStrategy="shortest">
                                        <Position> <LanePosition roadId="0" laneId="1" offset="0.0" s="20.0"/> </Position>
                                    </Waypoint>
                                </Route>
                            </AssignRouteAction>
                        </RoutingAction>
                    </PrivateAction>
                </Private>

                <!-- 2. 对向货车 (Road 0, 北 -> 南) -->
                <Private entityRef="OcclusionTruck">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="0" laneId="-1" offset="0.0" s="40.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="15.88"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                    <PrivateAction>
                        <RoutingAction>
                            <AssignRouteAction>
                                <Route name="Truck_Straight" closed="false">
                                    <Waypoint routeStrategy="shortest">
                                        <Position> <LanePosition roadId="0" laneId="-1" offset="0.0" s="40.0"/> </Position>
                                    </Waypoint>
                                    <Waypoint routeStrategy="shortest">
                                        <Position> <LanePosition roadId="1" laneId="-1" offset="0.0" s="60.0"/> </Position>
                                    </Waypoint>
                                </Route>
                            </AssignRouteAction>
                        </RoutingAction>
                    </PrivateAction>
                </Private>

                <!-- 
                    3. 自行车 (Offset 修正版)
                    roadId="7", s="16.39"
                    offset="10.0" (更靠外侧/路边)
                -->
                <Private entityRef="GhostBicyclist">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="7" laneId="-1" offset="10.0" s="16.39"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="0.0"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>

        <Story name="BlindSpotCrossingStory">
            <Act name="CrossingAct">
                <ManeuverGroup maximumExecutionCount="1" name="CrossingGroup">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="GhostBicyclist"/>
                    </Actors>
                    
                    <Maneuver name="BicycleCrossingManeuver">
                        <Event name="StartCrossingEvent" priority="overwrite">
                            
                            <!-- 触发条件: 货车快到路口接口处(s=75) -->
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="TruckBlocksView" delay="0" conditionEdge="rising">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="OcclusionTruck"/>
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <ReachPositionCondition tolerance="2.0">
                                                    <Position>
                                                        <LanePosition roadId="0" laneId="-1" s="75.0"/>
                                                    </Position>
                                                </ReachPositionCondition>
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>

                            <Action name="SetCycleSpeed">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" value="5.0" dynamicsDimension="rate"/>
                                            <SpeedActionTarget>
                                                <!-- 速度 4.5 m/s -->
                                                <AbsoluteTargetSpeed value="4.5"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            
                            <Action name="CycleFollowPath">
                                <PrivateAction>
                                    <RoutingAction>
                                        <FollowTrajectoryAction>
                                            <Trajectory name="CrosswalkPath" closed="false">
                                                <Shape>
                                                    <Polyline>
                                                        <!-- 
                                                            轨迹: Offset 10.0 -> -10.0
                                                            横穿距离更长，从更深处冲出来，确保切断自车路径
                                                        -->
                                                        <Vertex>
                                                            <Position>
                                                                <LanePosition roadId="7" laneId="-1" offset="10.0" s="16.39"/>
                                                            </Position>
                                                        </Vertex>
                                                        <Vertex>
                                                            <Position>
                                                                <LanePosition roadId="7" laneId="-1" offset="0.0" s="16.39"/>
                                                            </Position>
                                                        </Vertex>
                                                        <Vertex>
                                                            <Position>
                                                                <LanePosition roadId="7" laneId="-1" offset="-10.0" s="16.39"/>
                                                            </Position>
                                                        </Vertex>
                                                    </Polyline>
                                                </Shape>
                                                <TimeReference><None/></TimeReference>
                                                <TrajectoryFollowingMode followingMode="position"/>
                                            </Trajectory>
                                        </FollowTrajectoryAction>
                                    </RoutingAction>
                                </PrivateAction>
                            </Action>

                        </Event>
                    </Maneuver>
                </ManeuverGroup>
            </Act>
        </Story>
    </Storyboard>
</OpenSCENARIO>
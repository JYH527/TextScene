<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
    <FileHeader revMajor="1" revMinor="0" date="2025-12-02T15:45:00" description="Merge Collision with Rear Follower (Ego View Fixed)" author="ESMINI-Expert"/>
    
    <CatalogLocations>
        <VehicleCatalog>
            <Directory path="../resources/xosc/Catalogs/Vehicles"/>
        </VehicleCatalog>
    </CatalogLocations>

    <RoadNetwork>
        <LogicFile filepath="one-way-three-lane-ramp_in.xodr"/>
    </RoadNetwork>

    <!-- 1. 实体定义：将 'hero' 改为 'Ego' 并放在第一位 -->
    <Entities>
        <ScenarioObject name="Ego">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_red"/>
        </ScenarioObject>
        <ScenarioObject name="adversary">
            <CatalogReference catalogName="VehicleCatalog" entryName="semi_truck"/>
        </ScenarioObject>
        <ScenarioObject name="follower">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_yellow"/>
        </ScenarioObject>
    </Entities>

    <Storyboard>
        <Init>
            <Actions>
                <GlobalAction>
                    <EnvironmentAction>
                        <Environment name="Night_Rain">
                            <TimeOfDay animation="false" dateTime="2023-11-29T22:00:00"/>
                            <Weather cloudState="overcast">
                                <Sun intensity="0.0" azimuth="0.0" elevation="0.0"/>
                                <Fog visualRange="10000.0"/>
                                <Precipitation precipitationType="rain" intensity="1.0"/>
                            </Weather>
                            <RoadCondition frictionScaleFactor="1.0"/>
                        </Environment>
                    </EnvironmentAction>
                </GlobalAction>
                <!-- 2. 初始化：Ego 必须第一个初始化 -->
                <!-- Road 1, Lane -4, s=15.0 (给后车留空间) -->
                <Private entityRef="Ego">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-4" offset="0.0" s="5.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="13.88"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>

                <!-- 后随车: Road 1, Lane -4, s=0.0 (在 Ego 后面 15米) -->
                <Private entityRef="follower">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-4" offset="0.0" s="0.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="10.88"/> <!-- 同速跟随 -->
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>

                <!-- 敌车: Road 0 -->
                <Private entityRef="adversary">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="0" laneId="2" offset="0.0" s="15.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="11.11"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>

        <Story name="Merge_Follower_Story">
            <Act name="All_Move_Act">
                
                <!-- 3. 行为组分离：Ego 单独一组 -->
                <ManeuverGroup maximumExecutionCount="1" name="Ego_Maneuver_Group">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="Ego"/>
                    </Actors>
                    <Maneuver name="Ego_Route_Maneuver">
                        <Event name="Ego_Route_Event" priority="overwrite">
                            <Action name="Ego_Go_Straight">
                                <PrivateAction>
                                    <RoutingAction>
                                        <AcquirePositionAction>
                                            <Position><LanePosition roadId="2" laneId="-4" offset="0.0" s="40.0"/></Position>
                                        </AcquirePositionAction>
                                    </RoutingAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="Start_Now" delay="0" conditionEdge="rising">
                                        <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>

                <!-- NPC 组 (Adversary + Follower) -->
                <ManeuverGroup maximumExecutionCount="1" name="NPC_Maneuver_Group">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="adversary"/>
                        <EntityRef entityRef="follower"/>
                    </Actors>
                    <Maneuver name="NPC_Route_Maneuver">
                        <Event name="NPC_Route_Event" priority="overwrite">
                            <Action name="NPC_Go_Straight">
                                <PrivateAction>
                                    <RoutingAction>
                                        <AcquirePositionAction>
                                            <Position><LanePosition roadId="2" laneId="-4" offset="0.0" s="40.0"/></Position>
                                        </AcquirePositionAction>
                                    </RoutingAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="Start_Now" delay="0" conditionEdge="rising">
                                        <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>

                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="Act_Start" delay="0" conditionEdge="rising">
                            <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
            </Act>
        </Story>
        
        <StopTrigger>
            <ConditionGroup>
                <Condition name="Time_Limit" delay="0" conditionEdge="rising">
                    <ByValueCondition><SimulationTimeCondition value="10.0" rule="greaterThan"/></ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>
<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="0" date="2024-05-21T10:00:00" description="SCN_LIB_008: 车辆切出-目标车辆避让前方静止车. 测试Ego在跟随的前车为避让前方静止车辆而突然变道后，对突然暴露的静止障碍物的紧急制动（AEB）反应能力。" author="ASAM OpenSCENARIO Expert"/>

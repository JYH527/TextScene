											<SpeedActionTarget>
												<AbsoluteTargetSpeed value="0.0"/>
											</SpeedActionTarget>
										</SpeedAction>
									</LongitudinalAction>
								</PrivateAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="StartTime" delay="0" conditionEdge="rising">
										<ByValueCondition>
											<SimulationTimeCondition value="0.1" rule="greaterThan"/>
										</ByValueCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
					</Maneuver>
				</ManeuverGroup>
				<ManeuverGroup name="Ego_Decelerate_For_Obstacle_mg" maximumExecutionCount="1">
					<Actors selectTriggeringEntities="false">
						<EntityRef entityRef="Ego"/>
					</Actors>
					<Maneuver name="Ego_Decelerate_For_Obstacle_maneuver">
						<Event name="Ego_Decelerate_For_Obstacle_event" priority="overwrite">
							<Action name="Ego_Decelerate_For_Obstacle">
								<PrivateAction>

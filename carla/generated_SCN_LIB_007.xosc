<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
	<FileHeader revMajor="1" revMinor="0" date="2024-05-21T10:00:00" description="SCN_LIB_007: 低矮障碍物-纸箱探测与响应" author="ASAM OpenSCENARIO Expert"/>

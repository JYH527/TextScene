          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="OcclusionGhostHeadStory">
      <Act name="OcclusionGhostHeadStory_act">
        <ManeuverGroup maximumExecutionCount="1" name="Ego_Initial_Cruise_mg">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Ego"/>
          </Actors>
          <Maneuver name="Ego_Initial_Cruise_maneuver">
            <Event name="Ego_Initial_Cruise_event" priority="parallel">
              <Action name="Ego_Initial_Cruise">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="8.4"/>
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="Start" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0.0" rule="greaterThan"/>
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup maximumExecutionCount="1" name="Truck_Static_mg">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Adv_1"/>
          </Actors>
          <Maneuver name="Truck_Static_maneuver">
            <Event name="Truck_Static_event" priority="parallel">
              <Action name="Truck_Static">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="0.0"/>
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="Start" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0.1" rule="greaterThan"/>
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup maximumExecutionCount="1" name="Child_Cross_Road_Challenge_mg">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Adv_2"/>
          </Actors>
          <Maneuver name="Child_Cross_Road_Challenge_maneuver">
            <Event name="Child_Cross_Road_Challenge_event" priority="overwrite">
              <Action name="Child_Follow_Defined_Path_Action">
                <PrivateAction>
                  <RoutingAction>
                    <FollowTrajectoryAction>
                      <Trajectory name="PedestrianCrossingPath" closed="false">
                        <Shape>
                          <Polyline>
                            <!-- MODIFIED: Vertex 1 now matches the new starting position of the pedestrian. -->
                            <Vertex time="0.0">
                              <Position>
                                <LanePosition roadId="1" laneId="-3" s="104.0" offset="-1.5"/>
                              </Position>
                            </Vertex>
                            <!--
                              MODIFIED: Vertex 2 is the end of the crossing path.
                              Time is recalculated for the new crossing distance (~6.5m) at ~1.5m/s.
                            -->
                            <Vertex time="6.50">
                              <Position>
                                <!-- The target is the far side of the Ego's lane (-2). -->
                                <LanePosition roadId="1" laneId="-1" s="104.0" offset="1.5"/>
                              </Position>
                            </Vertex>
                          </Polyline>
                        </Shape>
                      </Trajectory>
                      <TimeReference>
                        <Timing domainAbsoluteRelative="relative" scale="1.0" offset="0"/>
                      </TimeReference>
                      <TrajectoryFollowingMode followingMode="follow"/>
                    </FollowTrajectoryAction>
                  </RoutingAction>
                </PrivateAction>
              </Action>
              <!-- The absolute position trigger remains the most robust solution -->
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="Child_Cross_Trigger_By_Position" delay="0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Ego"/>
                      </TriggeringEntities>
                      <EntityCondition>
                        <ReachPositionCondition tolerance="2.0">
                          <Position>
                            <LanePosition roadId="1" laneId="-2" s="70.0"/>
                          </Position>
                        </ReachPositionCondition>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup maximumExecutionCount="1" name="Ego_React_Brake_mg">
          <Actors selectTriggeringEntities="false"> <!-- 改为false，因为执行者是固定的Ego -->
            <EntityRef entityRef="Ego"/>
          </Actors>
          <Maneuver name="Ego_React_Brake_maneuver">
            <Event name="Ego_React_Brake_event" priority="overwrite">
              <Action name="Ego_React_Brake">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="linear" value="8.5" dynamicsDimension="rate"/>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="0.0"/>
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <!-- 触发条件：当Ego与行人Adv_2的距离小于20米时 -->
                  <Condition name="Ego_Brake_Trigger" delay="0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Ego"/>
                      </TriggeringEntities>
                      <EntityCondition>
                        <RelativeDistanceCondition entityRef="Adv_2" relativeDistanceType="cartesianDistance" value="16" freespace="false" rule="lessThan"/>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="Act_Start_Trigger" delay="0" conditionEdge="rising">
              <ByValueCondition>
                <SimulationTimeCondition value="0.1" rule="greaterThan"/>
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="SimulationTime" delay="0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition value="20" rule="greaterThan"/>
          </ByValueCondition>
        </Condition>
        <Condition name="Collision" delay="0" conditionEdge="rising">
          <ByEntityCondition>
            <TriggeringEntities triggeringEntitiesRule="any">
              <EntityRef entityRef="Ego"/>
            </TriggeringEntities>
            <EntityCondition>
              <CollisionCondition/>
            </EntityCondition>
          </ByEntityCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
